# ==========================================
# CONFIGURACIÓN DE PRODUCCIÓN - SPENDBOT SUITE
# ==========================================

# 1. Telegram Bot Token (Obtenido de @BotFather)
TELEGRAM_BOT_TOKEN=tu_token_de_telegram_aqui

# 2. Gemini API Key (Para procesamiento NLP de gastos)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# 3. Secreto para firmar cookies de sesión en Next.js
SESSION_SECRET=un_secreto_super_seguro_y_largo_aqui

# 4. Puerto de producción para Next.js
PORT=3000
