# .env - Variables de entorno (NO subir a repositorio público)

# Telegram
TELEGRAM_BOT_TOKEN=tu_token_aqui

# Claude API
CLAUDE_API_KEY=tu_api_key_aqui

# Webhook (para despliegue en producción)
# WEBHOOK_URL=https://tu-dominio.com

# Puerto del servidor
PORT=8000

# Base de datos
DATABASE_URL=sqlite:///./gastos_mejorada.db

# Logging
LOG_LEVEL=INFO

# Zona horaria
TIMEZONE=America/Argentina/Buenos_Aires
