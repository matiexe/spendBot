# .env - Variables de entorno (NO subir a repositorio público)
# Este archivo contiene información sensible

# Token del bot obtenido de @BotFather en Telegram
TELEGRAM_BOT_TOKEN=8747119927:AAH8RfJ1XbIp7BT1zoEWyB8kkRQwwrLZMCQ

# URL del webhook (para despliegue en producción)
